// ============================================================
// EstHL TX — TradingView Indicator v6
// 台指期（TAIFEX TX）ORB + Estimated H-L Satisfaction Zone
//
// 進場邏輯（08:45–08:57 OR，08:58–09:15 進場窗口，只做多）：
//   1. Close > OR High（向上突破）
//   2. 30m 20MA 趨勢向上（Close30 > MA30_20）
//   3. OR 寬度在 0.5–1.5× RollingOR 內
//   4. 非週四、非週五（weekday 效應）
//   5. BigCost 濾網：or_high > max(BigCost1, BigCost2) + 0.5 × sl_dist
//      BigCost = 日盤成交量 > 20SMA 的 bar 的 VWAP（大戶成本）
//      BigCost1 = 昨日，BigCost2 = 前日
//
// 出場優先順序：
//   1. 固定停損（SL = entry - sl_fraction × EmaHL）
//   2. SatZone 兩段式出場
//        Phase 1：High ≥ SatZoneUpper → 標記觸及
//        Phase 2：觸及後 Close < 5MA → 出場
//   3. Dow Theory 追蹤停損（09:45 後，ta.pivotlow(5,5)，確認後 Close < 停損 → 出場）
//   4. 強制平倉 13:30
//
// SatZone 演算法（EstRange，對應 src/backtest/estimate_hl.py）：
//   - EmaHL = 20日 EMA（前一日日盤 H-L range）
//   - ema_cum_vol[slot] = 每個 5 分鐘 slot 的累積量 EMA(20)
//   - est_range = EmaHL × (今日累積量 / ema_cum_vol[slot])
//   - SatZoneUpper = session_low + est_range - EmaHL / 8
//   - 延遲一個 5 分鐘 slot（無 lookahead）
//
// 線條顏色說明：
//   Teal    ── OR High（開盤區間高點 08:45–08:57）
//   Orange  ── OR Low （開盤區間低點）
//   Blue    ── 30m 20MA（趨勢方向參考）
//   Yellow  ── BigCost1/2（大戶成本，昨日/前日）
//   White   ── BigCost 門檻（BC + 0.5×sl_dist，OR High 需突破此線）
//   Purple  ── SatZone Upper（滿足區上緣，持倉中顯示）
//   Red     ── SL（固定停損線）
//   Pink    ── Dow Theory 追蹤停損（09:45 後）
//
// 底色說明：
//   黃色  = OR 窗口（08:45–08:57）
//   藍色  = 進場窗口（08:58–09:15，且通過濾網）
//   紫色  = Trailing 區段（09:45–13:30）
//   灰色  = 當日濾網淘汰（OR寬度不符或週四/五）
// ============================================================
//@version=6
indicator(
    title   = "EstHL TX (ORB + SatZone Exit)",
    overlay = true
)

// ============================================================
// Inputs
// ============================================================
var string GRP_SL       = "停損"
var string GRP_OR       = "OR / 進場"
var string GRP_BIGCOST  = "BigCost 濾網（大戶成本）"
var string GRP_TREND    = "趨勢濾網（30m 20MA）"
var string GRP_DOW      = "星期濾網"
var string GRP_VIZ      = "顯示"

sl_fraction    = input.float(0.25, "SL = EmaHL ×",                  step=0.05, minval=0.05, group=GRP_SL,
                              tooltip="固定停損 = 進場價 - sl_fraction × EmaHL")
use_or_width   = input.bool (true, "啟用 OR 寬度濾網（0.5–1.5× RollingOR）", group=GRP_OR)
use_bigcost    = input.bool (true, "啟用 BigCost 濾網",               group=GRP_BIGCOST,
                              tooltip="or_high > max(BigCost1,BigCost2) + 0.5 × sl_dist")
bigcost_days   = input.int  (2,    "回看天數（1 或 2）",               minval=1, maxval=2, group=GRP_BIGCOST)
use_trend      = input.bool (true, "啟用 30m 20MA 趨勢濾網",          group=GRP_TREND)
skip_thu       = input.bool (true, "跳過週四（weekday 效應）",          group=GRP_DOW)
skip_fri       = input.bool (true, "跳過週五（weekday 效應）",          group=GRP_DOW)
show_or        = input.bool (true, "OR 高低線",                       group=GRP_VIZ)
show_bigcost   = input.bool (true, "BigCost 線（黃色）",               group=GRP_VIZ)
show_sat       = input.bool (true, "SatZone 線（紫色）",               group=GRP_VIZ)
show_sl_ln     = input.bool (true, "SL 線（紅色）",                    group=GRP_VIZ)
show_dow_ln    = input.bool (true, "Dow Trail 線（粉紅）",              group=GRP_VIZ)
show_bg        = input.bool (true, "時段底色",                         group=GRP_VIZ)
show_trend_ma  = input.bool (true, "30m 20MA 趨勢線（藍色）",           group=GRP_VIZ)
show_bc_thresh = input.bool (true, "BigCost 門檻線（白色虛線）",         group=GRP_VIZ)
show_diag      = input.bool (true, "濾網診斷 Label",                    group=GRP_VIZ)

// ============================================================
// Time Windows (Asia/Taipei = UTC+8)
// ============================================================
t_or_start    = timestamp("Asia/Taipei", year, month, dayofmonth,  8, 45)
t_or_end      = timestamp("Asia/Taipei", year, month, dayofmonth,  8, 57)
t_entry_start = timestamp("Asia/Taipei", year, month, dayofmonth,  8, 58)
t_entry_end   = timestamp("Asia/Taipei", year, month, dayofmonth,  9, 15)
t_trail_on    = timestamp("Asia/Taipei", year, month, dayofmonth,  9, 45)
t_force_exit  = timestamp("Asia/Taipei", year, month, dayofmonth, 13, 30)
t_day_end     = timestamp("Asia/Taipei", year, month, dayofmonth, 13, 45)

in_or_window  = time >= t_or_start    and time <= t_or_end
in_entry_win  = time >= t_entry_start and time <= t_entry_end
in_trail_zone = time >= t_trail_on    and time <  t_force_exit
at_force_exit = time >= t_force_exit  and time <  t_day_end
in_session    = time >= t_or_start    and time <  t_day_end

// ============================================================
// OR Window Transitions
// ============================================================
var bool prev_in_or = false
entering_or = in_or_window     and not prev_in_or
leaving_or  = not in_or_window and prev_in_or
prev_in_or := in_or_window

// ============================================================
// Opening Range (08:45–08:57)
// ============================================================
var float or_high  = na
var float or_low   = na
var float day_open = na
var bool  or_done  = false

if entering_or
    or_high  := na
    or_low   := na
    day_open := open
    or_done  := false

if in_or_window
    or_high := na(or_high) ? high : math.max(or_high, high)
    or_low  := na(or_low)  ? low  : math.min(or_low,  low)

if leaving_or
    or_done := true

// ============================================================
// Rolling OR (EMA-20 of daily OR widths)
// ============================================================
var float rolling_or = na

if leaving_or and not na(or_high) and not na(or_low)
    w = or_high - or_low
    rolling_or := na(rolling_or) ? w : rolling_or + (2.0 / 21.0) * (w - rolling_or)

or_width      = or_done and not na(or_high) ? or_high - or_low : float(na)
or_filter_pass = (not use_or_width or na(rolling_or) or
                  (not na(or_width) and
                   or_width >= 0.5 * rolling_or and
                   or_width <= 1.5 * rolling_or))

// ============================================================
// EmaHL — self-computed from DAY SESSION only
//
// ⚠️  request.security("D", high-low) includes the night session
//     on TAIFEX continuous contracts.  We track it ourselves.
//     Updated at each entering_or using the PREVIOUS day's range.
// ============================================================
var float ema_hl_sess  = na   // 20-day EMA of day-session H-L range

// ============================================================
// 30m 20MA Trend Filter
// ============================================================
// lookahead_on + [1] = 防重繪標準寫法：
//   lookahead_on 讓歷史 bar 行為與即時一致，
//   [1] 確保只取已收盤的前一根 30m bar，不偷看未來
[close30, ma30_20] = request.security(syminfo.tickerid, "30",
    [close[1], ta.sma(close, 20)[1]],
    lookahead = barmerge.lookahead_on)
trend_ok = not use_trend or na(close30) or na(ma30_20) or close30 > ma30_20

// ============================================================
// Session High/Low and Cumulative Volume
// ============================================================
var float sess_high = na
var float sess_low  = na
var float cum_vol   = 0.0

// EstRange: per-slot EMA of cumulative volume (60 × 5-min slots)
var float[] ema_cum_vol_arr = array.new_float(60, na)
var float[] today_profile   = array.new_float(60, na)
var int     vol_day_count   = 0
var int     prev_slot_5m    = -1

if entering_or
    // Record last slot of previous day (cum_vol not yet reset)
    if prev_slot_5m >= 0
        array.set(today_profile, prev_slot_5m, cum_vol)

    // Update ema_hl_sess from PREVIOUS day's range (read before reset)
    if not na(sess_high) and not na(sess_low) and sess_high > sess_low
        prev_hl      = sess_high - sess_low
        ema_hl_sess := na(ema_hl_sess) ? prev_hl : ema_hl_sess + (2.0/21.0) * (prev_hl - ema_hl_sess)

    // Update per-slot EMA of cumulative volume from yesterday's profile
    if not na(array.get(today_profile, 0))
        for i = 0 to 59
            cv = array.get(today_profile, i)
            if not na(cv)
                old_cv = array.get(ema_cum_vol_arr, i)
                new_cv = na(old_cv) ? cv : old_cv + (2.0 / 21.0) * (cv - old_cv)
                array.set(ema_cum_vol_arr, i, new_cv)
        vol_day_count += 1

    // Reset for new day
    sess_high    := na
    sess_low     := na
    cum_vol      := 0.0
    prev_slot_5m := -1
    for i = 0 to 59
        array.set(today_profile, i, na)

if in_session
    sess_high := na(sess_high) ? high : math.max(sess_high, high)
    sess_low  := na(sess_low)  ? low  : math.min(sess_low,  low)
    cum_vol   += volume

// ============================================================
// BigCost Computation（大戶成本，對應 Python BigCost1 / BigCost2）
//
// 演算法（與 src/backtest/runner.py build_bigcost 相同）：
//   - 日盤每根 1 分鐘 bar：若 volume > 20-bar SMA(volume)，納入計算
//   - BigCost = sum(volume × hl2) / sum(volume)（高量 VWAP）
//   - 每日日盤結束後儲存，BigCost1 = 昨日，BigCost2 = 前日
//
// ⚠️  在 1 分鐘圖上直接計算，不需 request.security_lower_tf。
// ============================================================
vol_sma20 = ta.sma(volume, 20)    // 20-bar 成交量 SMA（1 分鐘）

var float day_big_vol  = 0.0
var float day_big_cost = 0.0
var float bigcost1     = na        // 昨日大戶成本
var float bigcost2     = na        // 前日大戶成本

// 每日日盤開始時（entering_or）：封存前一日結果，重置累計
if entering_or
    prev_bc   = day_big_vol > 0 ? day_big_cost / day_big_vol : float(na)
    bigcost2 := bigcost1
    bigcost1 := prev_bc
    day_big_vol  := 0.0
    day_big_cost := 0.0

// 日盤期間累計大量 bar
if in_session and volume > vol_sma20
    day_big_vol  += volume
    day_big_cost += volume * hl2

// BigCost 濾網：突破點需高於最近 N 日大戶成本 + 0.5 × sl_dist
// （sl_dist 在此先用 EmaHL 暫估；進場時以實際 ema_hl_d 計算）
_bc_max = (bigcost_days >= 2 and not na(bigcost1) and not na(bigcost2) ? math.max(bigcost1, bigcost2) :
           not na(bigcost1) ? bigcost1 : float(na))

bigcost_ok(or_h, ema_hl) =>
    not use_bigcost or na(_bc_max) or (or_h > _bc_max + 0.5 * sl_fraction * ema_hl)

// BigCost 門檻線（用於視覺化）
_bc_threshold = not na(_bc_max) and not na(ema_hl_sess) ? _bc_max + 0.5 * sl_fraction * ema_hl_sess : float(na)

// ============================================================
// SatZone Computation — EstRange (Volume-Weighted)
//
// Replaces the hardcoded TIME_FACTORS table with actual volume profiles:
//   ema_range     = ema_hl_sess (EMA of daily H-L range, prior day)
//   ema_cum_vol   = per-5min-slot EMA of cumulative volume
//   est_range     = ema_range × (cum_vol_today / ema_cum_vol[slot])
//   sat_upper     = sess_low + est_range - ema_range / 8
//
// 60 slots (08:45–13:40), delayed by 1 slot (5 min) to prevent lookahead.
// Requires 20 days warmup (vol_day_count >= 20).
// ============================================================
_h   = hour(time,   "Asia/Taipei")
_m   = minute(time, "Asia/Taipei")
_t   = _h * 60 + _m

// 5-min slot index: 0 = 08:45, 1 = 08:50, ..., 59 = 13:40
_slot_5m = in_session ? math.max(0, math.min(59, math.floor((_t - 525) / 5))) : -1

var float sat_upper = na   // SatZoneUpper（進場後的目標）

slot_changed_5m = _slot_5m >= 0 and _slot_5m != prev_slot_5m

if entering_or
    sat_upper := na

// Compute new sat_upper at each 5-min slot boundary (1-slot delayed)
if slot_changed_5m
    if prev_slot_5m >= 0
        // Record cum_vol at end of previous slot
        array.set(today_profile, prev_slot_5m, cum_vol)

        // Compute EstRange → SatZone (delayed by 1 slot)
        if vol_day_count >= 20 and not na(ema_hl_sess)
            ema_cv = array.get(ema_cum_vol_arr, prev_slot_5m)
            if not na(ema_cv) and ema_cv > 0
                vol_ratio  = cum_vol / ema_cv
                est_range  = ema_hl_sess * vol_ratio
                if not na(sess_low)
                    sat_upper := sess_low + est_range - ema_hl_sess / 8.0

    prev_slot_5m := _slot_5m

// ============================================================
// Weekday Filter
// ============================================================
wd_ok = (not (skip_thu and dayofweek == dayofweek.thursday) and
         not (skip_fri and dayofweek == dayofweek.friday))

// ============================================================
// Position State
// ============================================================
var bool  in_pos      = false
var bool  day_traded  = false
var float sl_price    = na
var bool  sat_touched = false   // SatZone Phase 1 triggered
var float dow_stop    = na      // Dow Theory trailing stop

if entering_or
    day_traded := false
    if in_pos
        in_pos      := false
        sl_price    := na
        sat_touched := false
        dow_stop    := na

// Dow Theory trailing stop (active after 09:45)
// Uses ta.pivotlow(low, 5, 5): pivot confirmed when center bar is min of 5L+5R window.
// Mirrors Python pivotlow(5,5): deque maxlen=11, lows[5] == min(lows).
pivot_low = ta.pivotlow(low, 5, 5)

if in_pos and in_trail_zone and not na(pivot_low)
    dow_stop := na(dow_stop) ? pivot_low : math.max(dow_stop, pivot_low)

// SatZone Phase 1: zone touched?
if in_pos and not sat_touched and not na(sat_upper) and high >= sat_upper
    sat_touched := true

// ============================================================
// Exit Conditions (priority: SL > SatZone > Dow > Force)
// ============================================================
ma5 = ta.sma(close, 5)   // must be computed globally (Pine requires consistent execution)
exit_sl    = in_pos and not na(sl_price)  and close <= sl_price
exit_sat   = in_pos and sat_touched       and close < ma5
exit_dow   = in_pos and in_trail_zone     and not na(dow_stop) and close < dow_stop
exit_force = in_pos and at_force_exit
exit_signal = exit_sl or exit_sat or exit_dow or exit_force

// ============================================================
// Entry Condition
// ============================================================
can_enter   = (not in_pos and not day_traded and or_done and
               in_entry_win and or_filter_pass and wd_ok and
               not na(ema_hl_sess))
long_signal = can_enter and trend_ok and close > or_high and bigcost_ok(or_high, ema_hl_sess)

// ============================================================
// Apply State Changes (exit first, then entry)
// ============================================================
if exit_signal
    in_pos      := false
    sl_price    := na
    sat_touched := false
    dow_stop    := na

if long_signal
    in_pos      := true
    day_traded  := true
    sl_price    := close - sl_fraction * ema_hl_sess
    sat_touched := false
    dow_stop    := na

// ============================================================
// OR% Label
// ============================================================
var label live_lbl = na

if in_or_window and not na(or_high) and not na(or_low) and not na(day_open) and day_open > 0
    live_pct = (or_high - or_low) / day_open * 100
    label.delete(live_lbl)
    live_lbl := label.new(bar_index, or_high,
        str.format("OR {0,number,#.##}%…", live_pct),
        style=label.style_label_down, size=size.small,
        color=color.new(color.yellow, 40), textcolor=color.black)

if leaving_or and not na(or_high) and not na(or_low) and not na(day_open) and day_open > 0
    fin_pct   = (or_high - or_low) / day_open * 100
    day_pass  = or_filter_pass and wd_ok
    is_thu_skip = skip_thu and dayofweek == dayofweek.thursday
    is_fri_skip = skip_fri and dayofweek == dayofweek.friday
    wd_prefix   = is_thu_skip ? "Thu  " : is_fri_skip ? "Fri  " : ""
    lbl_color   = (day_pass                        ? color.teal :
                   is_thu_skip or is_fri_skip      ? color.new(color.orange, 50) : color.gray)
    reason      = day_pass ? " ✓" : " ✗"
    label.delete(live_lbl)
    label.new(bar_index, or_high,
        str.format("{0}OR {1,number,#.##}%{2}", wd_prefix, fin_pct, reason),
        style=label.style_label_down, size=size.small,
        color=lbl_color, textcolor=color.white)

    // ── 濾網診斷 Label（OR 下方，逐條列出 pass/fail）──────────
    if show_diag
        _trend_str  = not use_trend ? "off" : trend_ok ? "Y" : "N"
        _or_str     = not use_or_width ? "off" : or_filter_pass ? "Y" : "N"
        _wd_str     = wd_ok ? "Y" : (is_thu_skip ? "Thu" : "Fri")
        _bc_str     = not use_bigcost ? "off" : (na(_bc_max) ? "n/a" : (not na(or_high) and not na(ema_hl_sess) and bigcost_ok(or_high, ema_hl_sess) ? "Y" : "N"))
        _bc_val_str = na(_bc_max) ? "" : str.format("\nBC={0,number,#}", _bc_max)
        _ma_str     = na(ma30_20) ? "" : str.format("\nMA20={0,number,#}", ma30_20)
        _c30_str    = na(close30) ? "" : str.format(" C30={0,number,#}", close30)
        diag_txt    = str.format("Trend:{0} OR:{1} WD:{2} BC:{3}{4}{5}{6}",
                      _trend_str, _or_str, _wd_str, _bc_str,
                      _bc_val_str, _ma_str, _c30_str)
        label.new(bar_index, or_low,
            diag_txt,
            style=label.style_label_up, size=size.tiny,
            color=color.new(color.black, 30), textcolor=color.white)

// ============================================================
// Plots
// ============================================================
// ── 時段底色 ─────────────────────────────────────────────
day_filtered = or_done and (not or_filter_pass or not wd_ok)
bgcolor(show_bg and in_or_window                      ? color.new(color.yellow, 88) : na, title="OR 窗口（黃）")
bgcolor(show_bg and in_entry_win and not day_filtered ? color.new(color.blue,   92) : na, title="進場窗口（藍）")
bgcolor(show_bg and in_entry_win and day_filtered     ? color.new(color.gray,   88) : na, title="濾網淘汰（灰）")
bgcolor(show_bg and in_trail_zone                     ? color.new(color.purple, 94) : na, title="Trail 區段（紫）")

// ── 30m 20MA 趨勢線（藍色，日盤期間顯示）─────────────────
plot(show_trend_ma and in_session ? ma30_20 : na, "30m MA20 (Blue)",
     color=color.new(color.blue, 30), linewidth=2, style=plot.style_linebr)

// ── BigCost 線（黃色，參考用）──────────────────────────────
plot(show_bigcost ? bigcost1 : na, "BigCost1（昨日）",
     color=color.new(color.yellow, 0),  linewidth=2, style=plot.style_linebr)
plot(show_bigcost ? bigcost2 : na, "BigCost2（前日）",
     color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)

// ── BigCost 門檻線（白色虛線，OR 高點需突破此線才進場）─────
show_bc_line = show_bc_thresh and not na(_bc_threshold) and in_session and or_done
plot(show_bc_line ? _bc_threshold : na, "BigCost Threshold (White)",
     color=color.new(color.white, 20), linewidth=1, style=plot.style_cross)

// ── OR 高低線（OR 窗口 + 進場窗口，進場窗口結束後隱藏）──
show_or_line = show_or and not na(or_high) and (in_or_window or (or_done and in_entry_win))
plot(show_or_line ? or_high : na, "OR High (Teal)",
     color=color.teal,   linewidth=2, style=plot.style_linebr)
plot(show_or_line ? or_low  : na, "OR Low (Orange)",
     color=color.orange, linewidth=2, style=plot.style_linebr)

// ── SatZone Upper（常駐顯示；持倉中不透明，無持倉半透明）
plot(show_sat ? sat_upper : na, "SatZone Upper (Purple)",
     color=color.new(color.purple, in_pos ? 0 : 60),
     linewidth=2, style=plot.style_circles)

// ── SL 線（持倉中顯示）──────────────────────────────────
plot(show_sl_ln and in_pos ? sl_price : na, "SL (Red)",
     color=color.red, linewidth=2, style=plot.style_circles)

// ── Dow Theory 追蹤停損（09:45 後，持倉中顯示）──────────
plot(show_dow_ln and in_pos and in_trail_zone ? dow_stop : na, "Dow Trail (Pink)",
     color=color.new(color.red, 50), linewidth=1, style=plot.style_circles)

// ── 進場箭頭（紅色 ▲ IN）────────────────────────────────
plotshape(long_signal,
          title="Entry ▲ IN", style=shape.triangleup,
          location=location.belowbar, size=size.small,
          color=color.red, text="IN", textcolor=color.red)

// ── 出場箭頭（綠色 ▼ OUT）───────────────────────────────
plotshape(exit_signal,
          title="Exit ▼ OUT", style=shape.triangledown,
          location=location.abovebar, size=size.small,
          color=color.lime, text="OUT", textcolor=color.lime)

// ============================================================
// Alerts
// ============================================================
alertcondition(long_signal, title="EstHL Entry", message="EstHL TX — Entry ({{ticker}} {{close}})")
alertcondition(exit_signal, title="EstHL Exit",  message="EstHL TX — Exit ({{ticker}} {{close}})")
