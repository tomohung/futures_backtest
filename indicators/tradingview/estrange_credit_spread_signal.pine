// ============================================================
// EstRange Credit Spread Signal
//
// 在台指期 1 分 K 上顯示選擇權價差單進場訊號。
// 碰到 EstRange 水位時，跳出要下的單（strike + 方向）。
//
// 策略（2026-03-19 weekday optimization）：
//   D combo: Mon+Tue+Wed+Fri，skip Thu
//   碰到 Est High → Sell Put Spread
//   碰到 Est Low  → Sell Call Spread
//   逐 weekday exit: Mon=13:44, Tue=13:00, Wed=10:30, Fri=12:00
//   min_credit=5, skip settlement Wed
// ============================================================
//@version=6
indicator(
    title   = "EstRange Credit Spread Signal",
    overlay = true
)

// ============================================================
// Inputs
// ============================================================
ema_period   = input.int(20, "EMA Period", minval=5, maxval=100)
min_warmup   = input.int(3,  "最少暖機天數", minval=1, maxval=50)
frac         = input.float(0.65, "Fraction", step=0.01, minval=0.3, maxval=1.0)
spread_pct   = input.float(0.50, "Spread = ER ×", step=0.05, minval=0.1, maxval=1.0,
                           tooltip="Spread 寬度 = EstRange × 此值，round to 100")
max_spread   = input.int(200, "Max Spread", minval=100, maxval=500, step=100,
                         tooltip="Spread 寬度上限（看盤軟體限制）")
min_gap      = input.int(50, "Min Gap", minval=0, maxval=200, step=10,
                         tooltip="Est High - Est Low 最小間距（< 此值不做，避免大波動日）")
min_credit   = input.float(5.0, "Min Credit", step=1.0, minval=0, maxval=50,
                           tooltip="Credit 低於此值不做（Wed/Fri DTE=0 扣手續費後不划算）")
skip_thu     = input.bool(true, "Skip Thursday", tooltip="Thu 不做（所有 exit time 都虧損）")
skip_settlement = input.bool(true, "Skip Settlement", tooltip="結算日不做（第三個週三，勝率僅 46%）")

// ============================================================
// Time
// ============================================================
_h = hour(time, "Asia/Taipei")
_m = minute(time, "Asia/Taipei")
_t = _h * 60 + _m

in_session    = _t >= 525 and _t < 825    // 08:45 ~ 13:44
is_wed        = dayofweek == dayofweek.wednesday
is_thu        = dayofweek == dayofweek.thursday
is_fri        = dayofweek == dayofweek.friday
is_mon        = dayofweek == dayofweek.monday
is_tue        = dayofweek == dayofweek.tuesday

// Per-weekday exit time (minutes from midnight)
// Mon=13:44(824), Tue=13:00(780), Wed=10:30(630), Fri=12:00(720)
_exit_t = is_mon ? 824 : is_tue ? 780 : is_wed ? 630 : is_fri ? 720 : 824

in_entry_win  = _t >= 570 and _t <= _exit_t   // 09:30 ~ weekday exit

// Detect 3rd Wednesday (settlement day)
_dom = dayofmonth(time, "Asia/Taipei")
is_3rd_wed = is_wed and _dom >= 15 and _dom <= 21

var int prev_session_day = -1
_cur_day = dayofmonth(time, "Asia/Taipei")
entering_session = in_session and _cur_day != prev_session_day
if in_session
    prev_session_day := _cur_day

// ============================================================
// Session Tracking + EstRange (same as est_range_tx.pine)
// ============================================================
var float sess_high = na
var float sess_low  = na
var float cum_vol   = 0.0
var float ema_range = na
float ema_alpha = 2.0 / (ema_period + 1)

var float[] ema_cum_vol_arr = array.new_float(60, na)
var float[] today_profile   = array.new_float(60, na)
var int     vol_day_count   = 0
var int     prev_slot_5m    = -1
var float   cur_est_range   = na

if entering_session
    if prev_slot_5m >= 0
        array.set(today_profile, prev_slot_5m, cum_vol)
    if not na(sess_high) and not na(sess_low) and sess_high > sess_low
        prev_hl    = sess_high - sess_low
        ema_range := na(ema_range) ? prev_hl : ema_range + ema_alpha * (prev_hl - ema_range)
    if not na(array.get(today_profile, 0))
        for i = 0 to 59
            cv = array.get(today_profile, i)
            if not na(cv)
                old_cv = array.get(ema_cum_vol_arr, i)
                new_cv = na(old_cv) ? cv : old_cv + ema_alpha * (cv - old_cv)
                array.set(ema_cum_vol_arr, i, new_cv)
        vol_day_count += 1
    sess_high    := na
    sess_low     := na
    cum_vol      := 0.0
    prev_slot_5m := -1
    cur_est_range := na
    for i = 0 to 59
        array.set(today_profile, i, na)

if in_session
    sess_high := na(sess_high) ? high : math.max(sess_high, high)
    sess_low  := na(sess_low)  ? low  : math.min(sess_low,  low)
    cum_vol   += volume

_slot_5m = in_session ? int(math.max(0, math.min(59, math.floor((_t - 525) / 5.0)))) : -1
slot_changed_5m = _slot_5m >= 0 and _slot_5m != prev_slot_5m
if slot_changed_5m
    if prev_slot_5m >= 0
        array.set(today_profile, prev_slot_5m, cum_vol)
        if vol_day_count >= min_warmup and not na(ema_range)
            ema_cv = array.get(ema_cum_vol_arr, prev_slot_5m)
            if not na(ema_cv) and ema_cv > 0
                vol_ratio     = cum_vol / ema_cv
                cur_est_range := ema_range * vol_ratio
    prev_slot_5m := _slot_5m

// ============================================================
// Trigger Levels + Signal
// ============================================================
ready = not na(cur_est_range) and not na(sess_low) and not na(sess_high) and not (skip_settlement and is_3rd_wed) and not (skip_thu and is_thu)

est_high = ready ? sess_low  + cur_est_range * frac : na
est_low  = ready ? sess_high - cur_est_range * frac : na

// Spread width (round to 100, min 100, cap at max_spread)
_spread_raw = ready ? cur_est_range * spread_pct : na
spread_w    = ready ? math.min(max_spread, math.max(100, math.round(_spread_raw / 100) * 100)) : na

// Track if triggered today
var bool  day_triggered  = false
var int   signal_dir     = 0       // 1 = sell put, -1 = sell call
var int   sell_strike    = 0
var int   buy_strike     = 0
var float entry_credit   = na

if entering_session
    day_triggered := false
    signal_dir    := 0
    sell_strike   := 0
    buy_strike    := 0
    entry_credit  := na

// Check trigger (require min gap between est_high and est_low)
gap_ok        = ready and est_high - est_low >= min_gap
trigger_long  = gap_ok and in_entry_win and not day_triggered and high >= est_high
trigger_short = gap_ok and in_entry_win and not day_triggered and low  <= est_low

if trigger_long
    // Price hit Est High → Sell Put Spread
    day_triggered := true
    signal_dir    := 1
    sell_strike   := int(math.round(est_low / 100) * 100)
    buy_strike    := sell_strike - int(spread_w)

if trigger_short
    // Price hit Est Low → Sell Call Spread
    day_triggered := true
    signal_dir    := -1
    sell_strike   := int(math.round(est_high / 100) * 100)
    buy_strike    := sell_strike + int(spread_w)

// ============================================================
// Display
// ============================================================

// Est High / Est Low lines (always show when available; dimmer after trigger or outside entry window)
_lvl_bright = ready and in_entry_win and not day_triggered
plot(ready ? est_high : na, "Est High",
     color=color.new(color.green, _lvl_bright ? 30 : 70), linewidth=2, style=plot.style_linebr)
plot(ready ? est_low : na, "Est Low",
     color=color.new(color.red, _lvl_bright ? 30 : 70), linewidth=2, style=plot.style_linebr)

// Entry signal label
_cr_note = min_credit > 0 ? str.format("\nCredit < {0} 不做", min_credit) : ""

if trigger_long
    // 賣權多頭價差 (Bull Put Spread) — 紅色，配合下單軟體
    _txt = str.format("賣權多頭價差\n買 P{0} / 賣 P{1}\nSpread {2}  ER {3,number,#}{4}",
                       buy_strike, sell_strike, int(spread_w), cur_est_range, _cr_note)
    label.new(bar_index, low,
        _txt,
        style=label.style_label_up, size=size.normal,
        color=color.new(color.red, 0), textcolor=color.white)

if trigger_short
    // 買權空頭價差 (Bear Call Spread) — 綠色，配合下單軟體
    _txt = str.format("買權空頭價差\n買 C{0} / 賣 C{1}\nSpread {2}  ER {3,number,#}{4}",
                       buy_strike, sell_strike, int(spread_w), cur_est_range, _cr_note)
    label.new(bar_index, high,
        _txt,
        style=label.style_label_down, size=size.normal,
        color=color.new(color.green, 0), textcolor=color.white)

// Show sell strike as horizontal line after triggered (until exit)
var bool  strike_hit   = false   // sell strike has been touched → stop loss
var bool  sl_alerted   = false

if entering_session
    strike_hit := false
    sl_alerted := false

// Detect sell strike touch (stop loss trigger)
if day_triggered and not strike_hit and in_session and _t <= _exit_t
    if signal_dir == 1 and low <= sell_strike
        strike_hit := true
    if signal_dir == -1 and high >= sell_strike
        strike_hit := true

show_strike = day_triggered and in_session and _t <= _exit_t and not strike_hit
_strike_color = color.new(color.orange, 20)
plot(show_strike and signal_dir == 1  ? sell_strike : na, "賣權多頭 Strike",
     color=_strike_color, linewidth=2, style=plot.style_linebr)
plot(show_strike and signal_dir == -1 ? sell_strike : na, "買權空頭 Strike",
     color=_strike_color, linewidth=2, style=plot.style_linebr)

// Stop loss label when sell strike touched
if strike_hit and not sl_alerted
    _side = signal_dir == 1 ? "賣權多頭" : "買權空頭"
    label.new(bar_index, signal_dir == 1 ? low : high,
        str.format("⚠️ Strike 被碰！\n立即買回{0}價差", _side),
        style=signal_dir == 1 ? label.style_label_up : label.style_label_down,
        size=size.normal,
        color=color.new(color.red, 0), textcolor=color.white)
    sl_alerted := true

// Exit reminder at per-weekday exit time (only if not already stopped out)
_exit_h = int(math.floor(_exit_t / 60))
_exit_m = _exit_t % 60
t_exit = timestamp("Asia/Taipei", year, month, dayofmonth, _exit_h, _exit_m)
at_exit = time >= t_exit and time < t_exit + 60000  // within 1 min of exit
_exit_label = str.format("{0,number,00}:{1,number,00}", _exit_h, _exit_m)
if at_exit and day_triggered and not strike_hit
    _side = signal_dir == 1 ? "賣權多頭" : "買權空頭"
    label.new(bar_index, close,
        str.format("{0} 收工\n買回{1}價差", _exit_label, _side),
        style=label.style_label_right, size=size.small,
        color=color.new(color.gray, 30), textcolor=color.white)

// Preparation labels on the last bar (one at Est High, one at Est Low)
// Show only when: ready, not triggered, still within entry window
// Delete when: triggered, past exit time, or skip day
var label _prep_high_lbl = na
var label _prep_low_lbl  = na
_show_prep = barstate.islast and ready and not day_triggered and in_entry_win
_hide_prep = barstate.islast and (day_triggered or _t > _exit_t or not ready)
if _show_prep
    _put_sell  = int(math.round(est_low / 100) * 100)
    _put_buy   = _put_sell - int(spread_w)
    _call_sell = int(math.round(est_high / 100) * 100)
    _call_buy  = _call_sell + int(spread_w)
    if not na(_prep_high_lbl)
        label.delete(_prep_high_lbl)
    if not na(_prep_low_lbl)
        label.delete(_prep_low_lbl)
    _prep_high_lbl := label.new(bar_index + 3, est_high, str.format("📋 賣權多頭價差\n買 P{0} / 賣 P{1}\nSpread {2}", _put_buy, _put_sell, int(spread_w)), style=label.style_label_left, size=size.normal, color=color.new(color.red, 20), textcolor=color.white)
    _prep_low_lbl := label.new(bar_index + 3, est_low, str.format("📋 買權空頭價差\n買 C{0} / 賣 C{1}\nSpread {2}", _call_buy, _call_sell, int(spread_w)), style=label.style_label_left, size=size.normal, color=color.new(color.green, 20), textcolor=color.white)
if _hide_prep
    if not na(_prep_high_lbl)
        label.delete(_prep_high_lbl)
        _prep_high_lbl := na
    if not na(_prep_low_lbl)
        label.delete(_prep_low_lbl)
        _prep_low_lbl := na

// Skip day warnings
if entering_session and skip_settlement and is_3rd_wed
    label.new(bar_index, high,
        "結算日 — 不做",
        style=label.style_label_down, size=size.small,
        color=color.new(color.gray, 60), textcolor=color.white)

if entering_session and skip_thu and is_thu
    label.new(bar_index, high,
        "Thu — 不做",
        style=label.style_label_down, size=size.small,
        color=color.new(color.gray, 60), textcolor=color.white)

// Background: entry window / in position / stop loss
bgcolor(in_entry_win and not day_triggered and ready and not (skip_settlement and is_3rd_wed) and not (skip_thu and is_thu) ?
        color.new(color.blue, 94) : na, title="進場窗口")
bgcolor(day_triggered and not strike_hit and in_session and _t <= _exit_t ?
        color.new(color.green, 94) : na, title="持倉中")
bgcolor(strike_hit and in_session and _t <= _exit_t ?
        color.new(color.red, 90) : na, title="停損觸發")

// ============================================================
// Alerts
// ============================================================
alertcondition(trigger_long,
    title="賣權多頭價差",
    message="EstRange: 賣權多頭價差 (TX {{close}})")

alertcondition(trigger_short,
    title="買權空頭價差",
    message="EstRange: 買權空頭價差 (TX {{close}})")

alertcondition(strike_hit and not sl_alerted,
    title="Stop Loss — 買回價差",
    message="⚠️ Strike 被碰！立即買回價差 (TX {{close}})")

alertcondition(at_exit and day_triggered and not strike_hit,
    title="Exit — 買回價差",
    message="EstRange: 收工買回價差 (TX {{close}})")
