// ============================================================
// Key Prices TX — 關卡價(達到率)表格
//
// 複製 chart-ui 右側欄「關卡價」面板，畫成 TradingView 表格。
// 關卡價隨當日盤中新高/新低即時更新。
//
// 演算法（對齊 src/chart_ui/services/daystats.py）：
//   ema20      = 前 20 個交易日「日盤振幅(high-low)」的因果式 EMA(adjust=False)
//   五階距離   = c × ema20，c = 0.385 / 0.497 / 0.711 / 0.977 / 1.225
//                達到率(碰到機率) = 90% / 75% / 50% / 25% / 12.5%
//                (L5=1.225 出自 H095 pooled 分位，延伸長尾關卡)
//   多方關卡   = 今低 + 距（由今低往上投射預估高）→ 紅色
//   空方關卡   = 今高 - 距（由今高往下投射預估低）→ 綠色
//   今高/今低  = 盤中即時高低，高亮白字
//   每組(多/空)各 6 列(L1~L5 + 今高/低)，依價格由高到低排序。
//
//   續航提示（碰 L1 後依「首觸時間」查表決定瞄第幾階）：
//     碰 L1 → 續 L2 / 續 L3 機率；碰 L2 後再更新一次續 L3。
//     time 為當日分鐘數（08:45 = 525）；step function。
//   第三欄「出場提示」：續航提示 + 狀態感知出場速記（碰 L3 後依「目前最高關卡」
//     顯示該階出場分支規則）。Pine 無 DCI（TV 抓不到台股廣度），故只列分支不替你選；
//     實際拆分依盤中即時 DCI。完整 DCI 出場階梯見 chart-ui 覆盤面板 / journal_checklist.md v5.4。
//
// 僅用日盤 08:45–13:45。延遲 1 天暖機，EMA 用前一日收盤後才更新（無 lookahead）。
//
// Alert：每階（多/空 × L1~L5，共 10 個）各有獨立 alertcondition，於 TradingView
//   「建立警報」對話框的下拉選單逐一挑選；另有一個 alert() 動態訊息涵蓋「任一關卡觸及」
//   （建警報時選「Any alert() function call」）。觸發定義＝方向性擺幅 ≥ d_i（與觸及面板同義），
//   每階每日只在首觸那根 true，建議用「once per bar」。
// ============================================================
//@version=6
indicator(
    title   = "Key Prices TX (關卡價表)",
    overlay = true,
    max_lines_count = 200,
    max_labels_count = 20
)

// ============================================================
// Inputs
// ============================================================
var string GRP_CALC = "計算參數"
var string GRP_VIZ  = "顯示"

ema_period   = input.int(20, "EMA Period", minval=5, maxval=100, group=GRP_CALC)
min_warmup   = input.int(3, "最少暖機天數", minval=1, maxval=50,
                         tooltip="累積幾個日盤後開始顯示（與 EstRange 一致）。EMA 仍以 EMA Period 平滑，天數越多越成熟", group=GRP_CALC)

show_table   = input.bool(true,  "顯示關卡價表格", group=GRP_VIZ)
show_bull    = input.bool(true,  "多方關卡線（紅）", group=GRP_VIZ)
show_bear    = input.bool(true,  "空方關卡線（綠）", group=GRP_VIZ)
show_lbl     = input.bool(true,  "線旁標示 L1~L4", group=GRP_VIZ)
show_hint    = input.bool(true,  "顯示續航提示", group=GRP_VIZ)
show_vlines  = input.bool(true,  "時間直線 9:30/10:30/11:30（灰）", group=GRP_VIZ)
tbl_pos_in   = input.string("middle_right", "表格位置",
                 options=["top_right", "middle_right", "bottom_right", "top_left", "bottom_left"],
                 group=GRP_VIZ)
txt_size_in  = input.string("small", "字體大小", options=["tiny","small","normal","large"], group=GRP_VIZ)

// 四階係數（c × ema20）
c1 = input.float(0.385, "L1 係數 (90%)", step=0.001, group=GRP_CALC)
c2 = input.float(0.497, "L2 係數 (75%)", step=0.001, group=GRP_CALC)
c3 = input.float(0.711, "L3 係數 (50%)", step=0.001, group=GRP_CALC)
c4 = input.float(0.977, "L4 係數 (25%)", step=0.001, group=GRP_CALC)
c5 = input.float(1.225, "L5 係數 (12.5%)", step=0.001, group=GRP_CALC)

// 配色（台灣慣例：多/漲=紅，空/跌=綠）
col_bull   = color.new(#ff5c5c, 0)   // 多方 紅（調亮，黑底更清楚）
col_bear   = color.new(#22c55e, 0)   // 空方 綠
col_muted  = color.new(#888888, 0)   // 標籤灰
col_text   = color.new(#e0e0e0, 0)   // 今高/今低 白
col_today  = color.new(#2a2a2a, 0)   // 今高/今低 高亮底
col_panel  = color.new(#161616, 10)  // 表格底
col_border = color.new(#2a2a2a, 0)

// ============================================================
// Time Windows (Asia/Taipei = UTC+8)
// ============================================================
_h = hour(time, "Asia/Taipei")
_m = minute(time, "Asia/Taipei")
_t = _h * 60 + _m

in_session = _t >= 525 and _t < 825   // 08:45 ~ 13:44

var int prev_session_day = -1
_cur_day = dayofmonth(time, "Asia/Taipei")
entering_session = in_session and _cur_day != prev_session_day
if in_session
    prev_session_day := _cur_day

// ============================================================
// EMA20 of prior-day session range (causal, adjust=False)
// ============================================================
var float sess_high  = na
var float sess_low   = na
var float ema_range  = na
var int   day_count  = 0
float ema_alpha = 2.0 / (ema_period + 1)

if entering_session
    // 用「前一日」已收完的日盤振幅更新 EMA，再清空當日高低 → 無 lookahead
    if not na(sess_high) and not na(sess_low) and sess_high > sess_low
        prev_hl    = sess_high - sess_low
        ema_range := na(ema_range) ? prev_hl : ema_range + ema_alpha * (prev_hl - ema_range)
        day_count += 1
    sess_high := na
    sess_low  := na

if in_session
    sess_high := na(sess_high) ? high : math.max(sess_high, high)
    sess_low  := na(sess_low)  ? low  : math.min(sess_low,  low)

// 不要求 in_session：日盤收盤後 / 夜盤時段仍延用「當日日盤」的高低與關卡。
// （TX 在 TV 多含夜盤，最後一根 K 常落在日盤外；若要求 in_session 會誤判「資料不足」）
ready = day_count >= min_warmup and not na(ema_range) and not na(sess_high) and not na(sess_low)

// 四階距離（當日 ema_range 固定）
d1 = ema_range * c1
d2 = ema_range * c2
d3 = ema_range * c3
d4 = ema_range * c4
d5 = ema_range * c5

// 多方關卡（今低 + 距）
m1 = sess_low + d1
m2 = sess_low + d2
m3 = sess_low + d3
m4 = sess_low + d4
m5 = sess_low + d5
// 空方關卡（今高 - 距）
s1 = sess_high - d1
s2 = sess_high - d2
s3 = sess_high - d3
s4 = sess_high - d4
s5 = sess_high - d5

// ============================================================
// 觸及追蹤（多方上擺 up_max / 空方下擺 dn_max，首觸時間記分鐘）
// ============================================================
var float run_lo  = na
var float run_hi  = na
var float up_max  = na
var float dn_max  = na
var int   bL1_min = na   // 多方碰 L1 的分鐘
var int   bL2_min = na
var int   sL1_min = na   // 空方碰 L1 的分鐘
var int   sL2_min = na

if entering_session
    run_lo  := na
    run_hi  := na
    up_max  := na
    dn_max  := na
    bL1_min := na
    bL2_min := na
    sL1_min := na
    sL2_min := na

if in_session
    run_lo := na(run_lo) ? low  : math.min(run_lo, low)
    run_hi := na(run_hi) ? high : math.max(run_hi, high)
    up_max := na(up_max) ? 0.0  : math.max(up_max, high - run_lo)
    dn_max := na(dn_max) ? 0.0  : math.max(dn_max, run_hi - low)
    if ready
        if na(bL1_min) and up_max >= d1
            bL1_min := _t
        if na(bL2_min) and up_max >= d2
            bL2_min := _t
        if na(sL1_min) and dn_max >= d1
            sL1_min := _t
        if na(sL2_min) and dn_max >= d2
            sL2_min := _t

// ============================================================
// 各關卡首觸 pulse（供 alert）
//   與上方觸及追蹤同義：方向性擺幅(多 up_max / 空 dn_max) ≥ d_i 即「觸及」。
//   每階每日只在「首觸的那一根」為 true，其餘 false → 適合設「once per bar」alert。
// ============================================================
var bool bt1 = false
var bool bt2 = false
var bool bt3 = false
var bool bt4 = false
var bool bt5 = false
var bool st1 = false
var bool st2 = false
var bool st3 = false
var bool st4 = false
var bool st5 = false
if entering_session
    bt1 := false
    bt2 := false
    bt3 := false
    bt4 := false
    bt5 := false
    st1 := false
    st2 := false
    st3 := false
    st4 := false
    st5 := false

touch_ok = ready and in_session and not na(up_max) and not na(dn_max)
bp1 = touch_ok and not bt1 and up_max >= d1
bp2 = touch_ok and not bt2 and up_max >= d2
bp3 = touch_ok and not bt3 and up_max >= d3
bp4 = touch_ok and not bt4 and up_max >= d4
bp5 = touch_ok and not bt5 and up_max >= d5
sp1 = touch_ok and not st1 and dn_max >= d1
sp2 = touch_ok and not st2 and dn_max >= d2
sp3 = touch_ok and not st3 and dn_max >= d3
sp4 = touch_ok and not st4 and dn_max >= d4
sp5 = touch_ok and not st5 and dn_max >= d5
if bp1
    bt1 := true
if bp2
    bt2 := true
if bp3
    bt3 := true
if bp4
    bt4 := true
if bp5
    bt5 := true
if sp1
    st1 := true
if sp2
    st2 := true
if sp3
    st3 := true
if sp4
    st4 := true
if sp5
    st5 := true

// 每階獨立 alertcondition（建警報時於下拉選單逐一挑選；{{close}} 為觸發當下價格）
alertcondition(bp1, "多方觸及 L1 (90%)",   "TX 多方觸及 L1 (90%地板)  close={{close}}")
alertcondition(bp2, "多方觸及 L2 (75%)",   "TX 多方觸及 L2 (75%)  close={{close}}")
alertcondition(bp3, "多方觸及 L3 (50%)",   "TX 多方觸及 L3 (50%)  close={{close}}")
alertcondition(bp4, "多方觸及 L4 (25%)",   "TX 多方觸及 L4 (25%)  close={{close}}")
alertcondition(bp5, "多方觸及 L5 (12.5%)", "TX 多方觸及 L5 (12.5% 長尾)  close={{close}}")
alertcondition(sp1, "空方觸及 L1 (90%)",   "TX 空方觸及 L1 (90%地板)  close={{close}}")
alertcondition(sp2, "空方觸及 L2 (75%)",   "TX 空方觸及 L2 (75%)  close={{close}}")
alertcondition(sp3, "空方觸及 L3 (50%)",   "TX 空方觸及 L3 (50%)  close={{close}}")
alertcondition(sp4, "空方觸及 L4 (25%)",   "TX 空方觸及 L4 (25%)  close={{close}}")
alertcondition(sp5, "空方觸及 L5 (12.5%)", "TX 空方觸及 L5 (12.5% 長尾)  close={{close}}")

// 任一關卡觸及（單一 alert 涵蓋全部；用 alert() 動態訊息）
any_touch = bp1 or bp2 or bp3 or bp4 or bp5 or sp1 or sp2 or sp3 or sp4 or sp5
if any_touch
    _side = (bp1 or bp2 or bp3 or bp4 or bp5) ? "多方" : "空方"
    _lvl = (bp1 or sp1) ? "L1(90%)" : (bp2 or sp2) ? "L2(75%)" : (bp3 or sp3) ? "L3(50%)" : (bp4 or sp4) ? "L4(25%)" : "L5(12.5%)"
    alert("TX " + _side + " 觸及 " + _lvl + "  價=" + str.tostring(close), alert.freq_once_per_bar)

// ============================================================
// 續航機率查表（step function；time = 分鐘數，08:45 = 525）
// ============================================================
f_contL2(mm) =>
    p = 94
    if mm >= 645
        p := 61
    else if mm >= 630
        p := 78
    else if mm >= 615
        p := 66
    else if mm >= 600
        p := 80
    else if mm >= 585
        p := 80
    else if mm >= 570
        p := 84
    else if mm >= 555
        p := 87
    else if mm >= 540
        p := 92
    p

f_contL3(mm) =>
    p = 76
    if mm >= 645
        p := 27
    else if mm >= 630
        p := 37
    else if mm >= 615
        p := 32
    else if mm >= 600
        p := 50
    else if mm >= 585
        p := 46
    else if mm >= 570
        p := 55
    else if mm >= 555
        p := 56
    else if mm >= 540
        p := 67
    p

f_contL3fromL2(mm) =>
    p = 86
    if mm >= 645
        p := 46
    else if mm >= 630
        p := 55
    else if mm >= 615
        p := 64
    else if mm >= 600
        p := 65
    else if mm >= 585
        p := 63
    else if mm >= 570
        p := 69
    else if mm >= 555
        p := 74
    else if mm >= 540
        p := 79
    p

// 第三欄某一方的整段文字（續航提示 + 累積出場速記），回傳「每列一行」的字串陣列。
//   為避免單格多行把該列撐高、撐歪價格階梯，這裡每行各佔一個 col2 列（單行），於表格端逐列寫入。
//   出場速記累積顯示：已碰的 L3/L4/L5 各壓一行（碰 L5 必然已過 L3/L4，故三行皆在）。Pine 無
//   DCI（TV 抓不到台股廣度），故只列分支不替你選；實際拆分依盤中即時 DCI。詳見 chart-ui 覆盤 / journal_checklist.md v5.4。
f_side_lines(side_zh, is_long, l1m, l2m, h3, h4, h5) =>
    a = array.new<string>()
    // 續航提示（最多 2 行）
    if na(l1m)
        array.push(a, side_zh + " 未碰 L1")
    else
        cc2 = f_contL2(l1m)
        cc3 = f_contL3(l1m)
        s1 = side_zh + " 碰L1→拿1階"
        if cc3 >= 50 and l1m < 570       // L3 須早於 09:30=570
            s1 := side_zh + " 碰L1→瞄3階 " + str.tostring(cc3) + "%"
        else if cc2 >= 50
            s1 := side_zh + " 碰L1→瞄2階 " + str.tostring(cc2) + "%"
        array.push(a, s1)
        if not na(l2m)
            cc3b = f_contL3fromL2(l2m)
            s2 = cc3b >= 50 ? "　碰L2→瞄3階 " + str.tostring(cc3b) + "%" : "　碰L2→守2階 " + str.tostring(cc3b) + "%"
            array.push(a, s2)
    // 出場速記（累積：已碰的 L3/L4/L5 各壓一行；多空不對稱，各關卡獨立判斷）
    if h3 and is_long
        array.push(a, "L3 依拆 <.2靜/.2-.4½/≥.4⅓")
    else if h3
        array.push(a, "L3 依拆 >-.2靜/≤-.2全口切Dow")
    if h4 and is_long
        array.push(a, "L4 再砍½ ≥.4⅓/.2-.4¼")
    else if h4
        array.push(a, "L4 分批 ≤-.2⅓/≤-.4¼/≤-.6⅕")
    if h5
        array.push(a, "L5 收緊 ①目標②反K③5MA清")
    a

// ============================================================
// 主圖水平線（盤中即時更新）
// ============================================================
f_line(ln, px, col, sty) =>
    line.set_xy1(ln, bar_index - 1, px)
    line.set_xy2(ln, bar_index + 8, px)
    line.set_style(ln, sty)
    if not na(px)
        line.set_color(ln, col)

f_hide(ln) =>
    line.set_xy1(ln, bar_index - 1, na)
    line.set_xy2(ln, bar_index + 8, na)

// 線右端標籤（L1~L4）
f_lbl(lb, px, txt, col) =>
    label.set_xy(lb, bar_index + 9, px)
    label.set_text(lb, show_lbl ? txt : "")
    label.set_textcolor(lb, col)

f_hide_lbl(lb) =>
    label.set_xy(lb, bar_index + 9, na)

var line lnM1 = line.new(na, na, na, na)
var line lnM2 = line.new(na, na, na, na)
var line lnM3 = line.new(na, na, na, na)
var line lnM4 = line.new(na, na, na, na)
var line lnM5 = line.new(na, na, na, na)
var line lnS1 = line.new(na, na, na, na)
var line lnS2 = line.new(na, na, na, na)
var line lnS3 = line.new(na, na, na, na)
var line lnS4 = line.new(na, na, na, na)
var line lnS5 = line.new(na, na, na, na)

var label lbM1 = label.new(na, na, "", style=label.style_none, size=size.small, textalign=text.align_left)
var label lbM2 = label.new(na, na, "", style=label.style_none, size=size.small, textalign=text.align_left)
var label lbM3 = label.new(na, na, "", style=label.style_none, size=size.small, textalign=text.align_left)
var label lbM4 = label.new(na, na, "", style=label.style_none, size=size.small, textalign=text.align_left)
var label lbM5 = label.new(na, na, "", style=label.style_none, size=size.small, textalign=text.align_left)
var label lbS1 = label.new(na, na, "", style=label.style_none, size=size.small, textalign=text.align_left)
var label lbS2 = label.new(na, na, "", style=label.style_none, size=size.small, textalign=text.align_left)
var label lbS3 = label.new(na, na, "", style=label.style_none, size=size.small, textalign=text.align_left)
var label lbS4 = label.new(na, na, "", style=label.style_none, size=size.small, textalign=text.align_left)
var label lbS5 = label.new(na, na, "", style=label.style_none, size=size.small, textalign=text.align_left)

// ---- 多方關卡線 ----
if show_bull and ready
    f_line(lnM1, m1, color.new(col_bull, 0),  line.style_solid)
    f_line(lnM2, m2, color.new(col_bull, 20), line.style_dashed)
    f_line(lnM3, m3, color.new(col_bull, 35), line.style_dashed)
    f_line(lnM4, m4, color.new(col_bull, 50), line.style_dotted)
    f_line(lnM5, m5, color.new(col_bull, 65), line.style_dotted)
    f_lbl(lbM1, m1, "L1", col_bull)
    f_lbl(lbM2, m2, "L2", col_bull)
    f_lbl(lbM3, m3, "L3", col_bull)
    f_lbl(lbM4, m4, "L4", col_bull)
    f_lbl(lbM5, m5, "L5", col_bull)
else
    f_hide(lnM1)
    f_hide(lnM2)
    f_hide(lnM3)
    f_hide(lnM4)
    f_hide(lnM5)
    f_hide_lbl(lbM1)
    f_hide_lbl(lbM2)
    f_hide_lbl(lbM3)
    f_hide_lbl(lbM4)
    f_hide_lbl(lbM5)

// ---- 空方關卡線 ----
if show_bear and ready
    f_line(lnS1, s1, color.new(col_bear, 0),  line.style_solid)
    f_line(lnS2, s2, color.new(col_bear, 20), line.style_dashed)
    f_line(lnS3, s3, color.new(col_bear, 35), line.style_dashed)
    f_line(lnS4, s4, color.new(col_bear, 50), line.style_dotted)
    f_line(lnS5, s5, color.new(col_bear, 65), line.style_dotted)
    f_lbl(lbS1, s1, "L1", col_bear)
    f_lbl(lbS2, s2, "L2", col_bear)
    f_lbl(lbS3, s3, "L3", col_bear)
    f_lbl(lbS4, s4, "L4", col_bear)
    f_lbl(lbS5, s5, "L5", col_bear)
else
    f_hide(lnS1)
    f_hide(lnS2)
    f_hide(lnS3)
    f_hide(lnS4)
    f_hide(lnS5)
    f_hide_lbl(lbS1)
    f_hide_lbl(lbS2)
    f_hide_lbl(lbS3)
    f_hide_lbl(lbS4)
    f_hide_lbl(lbS5)

// ============================================================
// 時間直線（9:30 / 10:30 / 11:30，灰色垂直虛線）
//   首次跨越各時刻時畫一條 extend.both 垂直線；以 rolling buffer
//   控制總數，避免擠掉上方 8 條關卡價 var 線（auto-prune 依建立順序）。
// ============================================================
col_vline   = color.new(#888888, 25)
var line[] vlines = array.new<line>()
int VLINE_MAX = 120   // 約 40 天 × 3 條

f_vline(_b) =>
    ln = line.new(bar_index, low, bar_index, high, extend = extend.both,
         color = col_vline, style = line.style_dashed, width = 1)
    array.push(vlines, ln)
    if array.size(vlines) > VLINE_MAX
        line.delete(array.shift(vlines))

var bool v930  = false
var bool v1030 = false
var bool v1130 = false
if entering_session
    v930  := false
    v1030 := false
    v1130 := false
if show_vlines and in_session
    if not v930 and _t >= 570        // 09:30
        f_vline(true)
        v930 := true
    if not v1030 and _t >= 630       // 10:30
        f_vline(true)
        v1030 := true
    if not v1130 and _t >= 690       // 11:30
        f_vline(true)
        v1130 := true

// ============================================================
// 表格
// ============================================================
f_pos(p) =>
    r = position.top_right
    if p == "middle_right"
        r := position.middle_right
    else if p == "bottom_right"
        r := position.bottom_right
    else if p == "top_left"
        r := position.top_left
    else if p == "bottom_left"
        r := position.bottom_left
    r

f_size(s) =>
    r = size.normal
    if s == "tiny"
        r := size.tiny
    else if s == "small"
        r := size.small
    else if s == "large"
        r := size.large
    r

var table tbl = table.new(position.top_right, 3, 15,
     border_width = 1, border_color = col_border, frame_width = 1, frame_color = col_border)

// 一列關卡（label, price, 文字色, 是否高亮）
f_row(t, ridx, lbl, px, txtcol, hl) =>
    bg = hl ? col_today : col_panel
    lc = hl ? col_text : col_muted
    pc = hl ? col_text : txtcol
    table.cell(t, 0, ridx, lbl, text_color = lc, text_halign = text.align_left,
         bgcolor = bg, text_size = f_size(txt_size_in))
    table.cell(t, 1, ridx, str.format("{0,number,#,###}", px), text_color = pc,
         text_halign = text.align_right, bgcolor = bg, text_size = f_size(txt_size_in))

if barstate.islast and show_table
    table.clear(tbl, 0, 0, 2, 14)
    if ready
        table.set_position(tbl, f_pos(tbl_pos_in))
        floor90 = math.round(d1)
        // r0 標題 + 副標
        table.cell(tbl, 0, 0, "關卡價·達到率", text_color = col_text, text_halign = text.align_left,
             bgcolor = col_today, text_size = f_size(txt_size_in))
        table.cell(tbl, 1, 0, str.format("EMA20 {0,number,#}", ema_range), text_color = col_muted,
             text_halign = text.align_right, bgcolor = col_today, text_size = f_size(txt_size_in))
        table.cell(tbl, 0, 1, "90%地板", text_color = col_muted, text_halign = text.align_left,
             bgcolor = col_panel, text_size = f_size(txt_size_in))
        table.cell(tbl, 1, 1, str.format("{0,number,#}", floor90), text_color = col_muted,
             text_halign = text.align_right, bgcolor = col_panel, text_size = f_size(txt_size_in))

        // ---- 多方組（多1-5 + 今高），依價格降序 ----
        bull_px  = array.from(m1, m2, m3, m4, m5, sess_high)
        bull_lbl = array.from("多1·90%", "多2·75%", "多3·50%", "多4·25%", "多5·12.5%", "今高")
        bull_hi  = array.from(false, false, false, false, false, true)
        bidx = array.sort_indices(bull_px, order.descending)
        for i = 0 to 5
            k = array.get(bidx, i)
            f_row(tbl, 2 + i, array.get(bull_lbl, k), array.get(bull_px, k), col_bull, array.get(bull_hi, k))

        // ---- 分隔列 ----
        table.cell(tbl, 0, 8, "──────", text_color = col_border, text_halign = text.align_left,
             bgcolor = col_panel, text_size = f_size(txt_size_in))
        table.cell(tbl, 1, 8, "", bgcolor = col_panel)

        // ---- 空方組（空1-5 + 今低），依價格降序 ----
        bear_px  = array.from(s1, s2, s3, s4, s5, sess_low)
        bear_lbl = array.from("空1·90%", "空2·75%", "空3·50%", "空4·25%", "空5·12.5%", "今低")
        bear_hi  = array.from(false, false, false, false, false, true)
        sidx = array.sort_indices(bear_px, order.descending)
        for i = 0 to 5
            k = array.get(sidx, i)
            f_row(tbl, 9 + i, array.get(bear_lbl, k), array.get(bear_px, k), col_bear, array.get(bear_hi, k))

        // ---- 第三欄：出場提示（續航 + 狀態感知出場速記，自動換行逐列鋪設）----
        //   多文字對齊多方組(row2-7)、空文字對齊空方組(row9-14)；每行各佔一列保持階梯對齊。
        if show_hint
            table.cell(tbl, 2, 0, "出場提示", text_color = col_text, text_halign = text.align_left,
                 bgcolor = col_today, text_size = f_size(txt_size_in))
            table.cell(tbl, 2, 1, "", bgcolor = col_panel)
            table.cell(tbl, 2, 8, "", bgcolor = col_panel)
            // 多方 → row 2..7
            blines = f_side_lines("多", true, bL1_min, bL2_min, bt3, bt4, bt5)
            for i = 0 to 5
                btxt = i < array.size(blines) ? array.get(blines, i) : ""
                table.cell(tbl, 2, 2 + i, btxt, text_color = col_bull, text_halign = text.align_left,
                     bgcolor = col_panel, text_size = f_size(txt_size_in))
            // 空方 → row 9..14
            slines = f_side_lines("空", false, sL1_min, sL2_min, st3, st4, st5)
            for i = 0 to 5
                stxt = i < array.size(slines) ? array.get(slines, i) : ""
                table.cell(tbl, 2, 9 + i, stxt, text_color = col_bear, text_halign = text.align_left,
                     bgcolor = col_panel, text_size = f_size(txt_size_in))
    else
        table.set_position(tbl, f_pos(tbl_pos_in))
        table.cell(tbl, 0, 0, "關卡價", text_color = col_text, bgcolor = col_today,
             text_size = f_size(txt_size_in))
        table.cell(tbl, 1, 0, "資料不足", text_color = col_muted, bgcolor = col_today,
             text_size = f_size(txt_size_in))
